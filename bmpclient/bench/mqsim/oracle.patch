+void IO_Flow_Trace_Based::dsa_dump_mapping()
+{
+    auto* device = dynamic_cast<SSD_Device*>(Simulator->GetObject("SSDDevice"));
+    if (!device) throw std::runtime_error("SSD device missing");
+    auto* ftl = dynamic_cast<SSD_Components::FTL*>(device->Firmware);
+    auto* amu = ftl->Address_Mapping_Unit;
+    if (!amu->Is_ideal_mapping_table()) throw std::runtime_error("DSA requires ideal mapping table");
+    const uint64_t sectors = device->Get_no_of_LHAs_in_an_NVM_write_unit();
+    const uint64_t pages = (dsa_max_sector + sectors - 1) / sectors;
+    if (pages > amu->Get_logical_pages_count(0)) throw std::runtime_error("Snapshot exceeds logical capacity");
+    std::ofstream out(std::getenv("DSA_ORACLE_MAPPING"));
+    if (!out) throw std::runtime_error("Cannot open PPA output");
+    out << "lpa,ppa,channel,chip,die,plane,block,page\n";
+    for (LPA_type lpa=0; lpa<pages; ++lpa) {
+        PPA_type ppa; page_status_type state;
+        amu->Get_data_mapping_info_for_gc(0, lpa, ppa, state);
+        if (state == 0 || ppa == NO_PPA) throw std::runtime_error("Unwritten snapshot page in PPA query");
+        auto a = amu->Convert_ppa_to_address(ppa);
+        out << lpa << ',' << ppa << ',' << a.ChannelID << ',' << a.ChipID << ',' << a.DieID << ',' << a.PlaneID << ',' << a.BlockID << ',' << a.PageID << '\n';
+    }
+    out.flush();
+    if (!out) throw std::runtime_error("PPA output failed");
+}
+
+void IO_Flow_Trace_Based::dsa_finish_batch()
+{
+    dsa_batches << dsa_batch << ',' << dsa_begin << ',' << Simulator->Time() << ','
+                << Simulator->Time()-dsa_begin << ',' << dsa_count << '\n';
+    dsa_batches.flush();
+    if (dsa_batch == 0) dsa_dump_mapping();
+    dsa_count = 0;
+    if (!dsa_eof) {
+        uint64_t next = std::stoull(current_trace_line[ASCIITraceDeviceColumn]);
+        if (next <= dsa_batch) throw std::runtime_error("DSA batch IDs must increase");
+        dsa_batch = next;
+        Simulator->Register_sim_event(Simulator->Time()+1, this);
+    }
+}
+
+void IO_Flow_Trace_Based::dsa_completed()
+{
+    if (dsa_inflight == 0) throw std::runtime_error("Unexpected completion");
+    --dsa_inflight;
+    // Defer until completion callback unwinds; never submit recursively in PHY signals.
+    if (dsa_inflight == 0 && (dsa_eof || std::stoull(current_trace_line[1]) != dsa_batch))
+        dsa_finish_batch();
+    else
+        Simulator->Register_sim_event(Simulator->Time()+1, this);
+}
+
+void IO_Flow_Trace_Based::dsa_pump()
+{
+    if (dsa_count == 0) dsa_begin = Simulator->Time();
+    while (!dsa_eof && dsa_inflight < dsa_window && std::stoull(current_trace_line[1]) == dsa_batch) {
+        bool write = current_trace_line[4] == "0";
+        if ((dsa_batch == 0) != write) throw std::runtime_error("Batch 0 writes only; later batches reads only");
+        auto* request = Generate_next_request();
+        if (!request) throw std::runtime_error("Truncated DSA trace");
+        const uint64_t end = request->Start_LBA + request->LBA_count;
+        // Reject MQSim's default address wrapping; no silent change to our layout.
+        if (request->Start_LBA != std::stoull(current_trace_line[2]) || end-1 > end_lsa_on_device)
+            throw std::runtime_error("DSA address wrapped or exceeds capacity");
+        if (write) dsa_max_sector = std::max(dsa_max_sector, end);
+        ++dsa_inflight; ++dsa_count;
+        Submit_io_request(request);
+        std::string line;
+        if (std::getline(trace_file, line)) {
+            current_trace_line.clear();
+            Utils::Helper_Functions::Remove_cr(line);
+            Utils::Helper_Functions::Tokenize(line, ASCIILineDelimiter, current_trace_line);
+            if (current_trace_line.size() != 5) throw std::runtime_error("Malformed DSA trace");
+        } else {
+            dsa_eof = true;
+            if (STAT_generated_request_count != total_requests_to_be_generated) throw std::runtime_error("DSA trace count mismatch");
+        }
+    }
+}
+
 } // namespace Host_Components
